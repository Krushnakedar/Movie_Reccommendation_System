# =============================================================================
# CineMatch backend configuration  (TEMPLATE -- placeholders only)
#
#   1. Copy this file to ".env" (same folder):   copy .env.example .env
#   2. Replace the placeholder below with your real TMDB token.
#   3. NEVER commit ".env". It is listed in .gitignore.
# =============================================================================

# REQUIRED -- your TMDB "API Read Access Token" (a long string starting with "eyJ").
# This is NOT the short 32-character "API Key". Get it at:
#   https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_api_read_access_token_here

# Port the backend listens on (the Vite dev server proxies /api to this port).
PORT=4000

# Browser origins allowed to call the API directly (comma-separated).
# Not needed when you use the Vite proxy, but required if the frontend is hosted elsewhere.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Language used for titles / overviews returned by TMDB (BCP-47, e.g. en-US, hi-IN).
TMDB_DEFAULT_LANGUAGE=en-US

# Max requests per minute per IP accepted by THIS backend (protects your TMDB token).
RATE_LIMIT_PER_MINUTE=120

# --- Optional -----------------------------------------------------------------
# Timeout (ms) for each request to TMDB.
# TMDB_TIMEOUT_MS=10000
# Override the TMDB base URL (only useful for testing against a stub server).
# TMDB_BASE_URL=https://api.themoviedb.org/3
